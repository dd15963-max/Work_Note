    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  },
